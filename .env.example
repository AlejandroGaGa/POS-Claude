# Cadena de conexión de MongoDB Atlas (incluye el nombre de la base, p. ej. /herrajes)
MONGODB_URI="mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/herrajes?retryWrites=true&w=majority"

# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Usuario administrador inicial (lo crea `npm run seed`)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"
SEED_ADMIN_NAME="Administrador"

# ── WhatsApp Cloud API (Meta) — opcional, para enviar la nota en PDF ──
# Ver README → "Enviar PDF por WhatsApp". Si faltan, el botón ofrece solo el resumen en texto.
WHATSAPP_TOKEN=""                 # token permanente del usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=""       # "Identificador del número de teléfono" (no es el número)
WHATSAPP_TEMPLATE_NAME="nota_pdf" # nombre exacto de la plantilla aprobada
WHATSAPP_TEMPLATE_LANG="es_MX"    # idioma con el que la aprobaste
WHATSAPP_TEMPLATE_BODY_PARAMS="4" # variables {{1}}..{{4}} del cuerpo
# WHATSAPP_API_VERSION="v21.0"
